{
  "preset": "ts-jest",
  "verbose": true,
  "clearMocks": true,
  "testEnvironment": "node",
  "moduleFileExtensions": ["js", "ts"],
  "testMatch": ["**/*.test.ts"],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.jest.json"
      }
    ]
  },
  "coverageReporters": ["json-summary", "text", "lcov"],
  "collectCoverage": true,
  "collectCoverageFrom": ["./src/**"],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 95,
      "lines": 95,
      "statements": 95
    }
  }
}
