{
  "name": "@gregory-gost/transmission-torrentdone",
  "version": "3.3.2",
  "description": "Torrent done script for transmission-daemon service",
  "license": "GPL-3",
  "keywords": [
    "gregory-gost",
    "transmission",
    "transmission-torrentdone",
    "transmission-daemon",
    "torrentdone",
    "torrent-done-script",
    "typescript",
    "proxmox",
    "lxc"
  ],
  "author": {
    "name": "Grigoriy Schetintsev (GregoryGost)",
    "email": "info@gregory-gost.ru"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint -c eslint.config.ts .",
    "lint:debug": "pnpm eslint --debug -c eslint.config.ts .",
    "package": "pnpm tsup",
    "all": "pnpm run format:write && pnpm run lint && pnpm run ci-test && pnpm run coverage && pnpm run package",
    "check-lib": "pnpm outdated"
  },
  "engines": {
    "node": "^26.12.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@tsconfig/node26": "26.0.1",
    "@types/jest": "30.0.0",
    "@types/nconf": "0.10.7",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.11",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jiti": "2.7.0",
    "make-coverage-badge": "1.2.0",
    "prettier": "3.9.10",
    "prettier-eslint": "17.1.2",
    "ts-jest": "29.4.14",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "log4js": "6.9.1",
    "nconf": "0.13.0"
  }
}
