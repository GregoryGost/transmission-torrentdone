{
  "name": "@gregory-gost/transmission-torrentdone",
  "version": "3.2.1",
  "description": "Torrent done script for transmission-daemon service",
  "license": "GPL-3",
  "keywords": [
    "gregory-gost",
    "transmission",
    "transmission-torrentdone",
    "transmission-daemon",
    "torrentdone",
    "torrent-done-script",
    "typescript",
    "proxmox",
    "lxc"
  ],
  "author": {
    "name": "Grigoriy Schetintsev (GregoryGost)",
    "email": "info@gregory-gost.ru"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint -c eslint.config.mjs .",
    "lint:debug": "pnpm eslint --debug -c eslint.config.mjs .",
    "package": "pnpm tsup",
    "all": "pnpm run format:write && pnpm run lint && pnpm run ci-test && pnpm run coverage && pnpm run package",
    "check-lib": "pnpm outdated"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.4",
    "@eslint/js": "9.22.0",
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/nconf": "0.10.7",
    "@types/node": "22.13.10",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "eslint": "9.22.0",
    "eslint-plugin-github": "5.1.8",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-jsonc": "2.19.1",
    "eslint-plugin-prettier": "5.2.3",
    "typescript-eslint": "8.26.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "log4js": "6.9.1",
    "make-coverage-badge": "1.2.0",
    "nconf": "0.12.1",
    "prettier": "3.5.3",
    "prettier-eslint": "16.3.0",
    "ts-jest": "29.2.6",
    "tsup": "8.4.0",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
