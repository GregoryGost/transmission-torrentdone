{
  "name": "@gregory-gost/transmission-torrentdone",
  "version": "3.3.1",
  "description": "Torrent done script for transmission-daemon service",
  "license": "GPL-3",
  "keywords": [
    "gregory-gost",
    "transmission",
    "transmission-torrentdone",
    "transmission-daemon",
    "torrentdone",
    "torrent-done-script",
    "typescript",
    "proxmox",
    "lxc"
  ],
  "author": {
    "name": "Grigoriy Schetintsev (GregoryGost)",
    "email": "info@gregory-gost.ru"
  },
  "scripts": {
    "bundle": "pnpm run format:write && pnpm run package",
    "ci-test": "pnpm jest",
    "coverage": "pnpm make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint -c eslint.config.mjs .",
    "lint:debug": "pnpm eslint --debug -c eslint.config.mjs .",
    "package": "pnpm tsup",
    "all": "pnpm run format:write && pnpm run lint && pnpm run ci-test && pnpm run coverage && pnpm run package",
    "check-lib": "pnpm outdated"
  },
  "engines": {
    "node": "^20.19.0 || >=24.13.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@eslint/js": "9.39.4",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/nconf": "0.10.7",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "eslint": "9.39.2",
    "eslint-plugin-github": "6.0.0",
    "eslint-plugin-jest": "29.15.4",
    "eslint-plugin-jsonc": "3.2.0",
    "eslint-plugin-prettier": "5.5.6",
    "typescript-eslint": "8.62.1",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "log4js": "6.9.1",
    "make-coverage-badge": "1.2.0",
    "nconf": "0.13.0",
    "prettier": "3.9.4",
    "prettier-eslint": "16.4.2",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
